# KrishiMitra backend configuration.
# Copy to .env for local development. Never commit .env.
# Schema and validation: app/core/config.py
# In staging/production these come from Cloud Run env vars + Secret Manager, not a file.

# --- Application ---
APP_ENV=local                      # local | test | staging | production
DEBUG=false
LOG_LEVEL=INFO                     # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_JSON=false                     # true in deployed environments (enforced)

# --- HTTP ---
API_V1_PREFIX=/api/v1
CORS_ALLOWED_ORIGINS=http://localhost:8010,http://127.0.0.1:8010
ENABLE_DOCS=true
ENABLE_DEV_UI=true                 # developer test UI; forced off in production
REQUEST_TIMEOUT_SECONDS=60

# --- Health checks ---
HEALTH_CHECK_TIMEOUT_SECONDS=2     # per dependency check in /health/ready
HEALTH_CACHE_SECONDS=5             # readiness result reuse; protects dependencies from probe floods

# --- PostgreSQL + pgvector ---
# Local docker compose: the defaults below.
# Supabase (dev): Dashboard > Connect > "Session pooler" values, e.g.
#   POSTGRES_HOST=aws-0-ap-south-1.pooler.supabase.com  POSTGRES_PORT=5432
#   POSTGRES_USER=postgres.<project-ref>  POSTGRES_DB=postgres  POSTGRES_SSL=require
# Production: Cloud SQL (private IP).
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=krishimitra
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=krishimitra
POSTGRES_SSL=prefer                # disable | prefer | require | verify-full
POSTGRES_STATEMENT_CACHE_SIZE=100  # 0 for transaction-mode poolers (Supabase port 6543)
POSTGRES_SCHEMA=krishimitra        # private schema: never exposed by Supabase's REST API
DATABASE_ENABLED=true
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=10
DB_POOL_PRE_PING=false             # true costs a round trip per checkout; reads retry instead
DB_POOL_RECYCLE_SECONDS=240
DB_WARMUP_CONNECTIONS=3
DB_COMMAND_TIMEOUT_SECONDS=30

# --- Redis ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# --- Google Cloud ---
GCP_PROJECT_ID=
GCP_REGION=asia-south1
GCS_BUCKET=
GCS_SIGNED_URL_TTL_SECONDS=3600   # signed URL lifetime for private media uploads/downloads

# --- LLM ---
LLM_PROVIDER=gemini                # gemini (anthropic | openai: not implemented yet)
LLM_MODEL=gemini-3.5-flash-lite
LLM_FALLBACK_PROVIDER=             # used when the primary model is overloaded / times out
LLM_FALLBACK_MODEL=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_OUTPUT_TOKENS=1024
LLM_TEMPERATURE=0.2
LLM_THINKING_LEVEL=                # empty = model default | minimal | low | medium | high
LLM_MAX_RETRIES=2                  # retries on 429/5xx/empty responses (not on timeouts)
LLM_INPUT_PRICE_PER_MILLION=0      # USD, for cost tracking (0 on free tier)
LLM_OUTPUT_PRICE_PER_MILLION=0
GOOGLE_GENAI_USE_VERTEXAI=true     # true: Vertex AI via ADC (production) | false: AI Studio API key
GOOGLE_API_KEY=                    # only if GOOGLE_GENAI_USE_VERTEXAI=false
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Embeddings ---
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=1536          # 768 | 1536 | 3072
EMBEDDING_BATCH_SIZE=50            # texts per API call (max 100)
EMBEDDING_REQUESTS_PER_MINUTE=90   # free tier: 100/min, each text counts; 0 = no throttle (paid)
EMBEDDING_TIMEOUT_SECONDS=60
EMBEDDING_MAX_RETRIES=6
EMBEDDING_QUERY_CACHE_SIZE=2048    # in-memory cache of recent query embeddings

# --- RAG ---
RAG_ENABLED=true
RAG_TOP_K=5                        # sources given to the LLM
RAG_CANDIDATES=30                  # candidates per search before fusion/re-ranking
RAG_MIN_SIMILARITY=0.55            # vector-only hits below this are dropped
RAG_HYBRID=true                    # vector + Postgres full-text (exact product/pest names)
RAG_MAX_CONTEXT_CHARS=6000         # ~1500 tokens of sources per question
RAG_TIMEOUT_SECONDS=8              # on timeout the answer is generated without sources

# --- Answer cache / startup ---
ANSWER_CACHE_SIZE=1000             # identical questions answered instantly; 0 disables
ANSWER_CACHE_TTL_SECONDS=21600     # 6 hours
WARMUP_ON_STARTUP=true             # open DB connections + AI clients before traffic

# --- Input limits ---
MAX_MESSAGE_CHARS=2000
MAX_IMAGE_BYTES=10485760           # 10 MB
MAX_VIDEO_BYTES=52428800           # 50 MB
MAX_VIDEO_SECONDS=60

# --- Image diagnosis ---
VISION_ENABLED=true
VISION_MODEL=gemini-3.5-flash-lite
VISION_FALLBACK_MODEL=gemini-3.5-flash
VISION_TIMEOUT_SECONDS=30
IMAGE_MODEL_MAX_SIDE=1024            # photo is resized to this before the AI call
IMAGE_MIN_CONFIDENCE=0.8             # below: uncertain (also always uncertain without a crop)
IMAGE_REJECT_POOR_QUALITY=true       # too dark/blurry/small: ask for retake, no AI call

# --- Video diagnosis (best frames -> image model, one call; audio never processed) ---
VIDEO_MODEL_FRAMES=4                 # frames sent to the model
VIDEO_CANDIDATE_FRAMES=16            # frames checked for sharpness/exposure
VIDEO_MAX_CONCURRENT=2               # video decodes at once per instance (CPU-heavy)

# --- Rate limiting (per client user) ---
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_PER_DAY=500
