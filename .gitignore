# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
.venv/
venv/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Secrets and local config - never commit
.env
.env.*
!.env.example
*.pem
*.key
service-account*.json
gcp-credentials*.json

# Source documents (large; stored in GCS in production)
documents/raw/*
!documents/raw/.gitkeep
documents/processed/*
!documents/processed/.gitkeep

# Local media / temp
tmp/
*.log

# IDE / OS
.idea/
.vscode/*
!.vscode/extensions.json
.DS_Store
Thumbs.db

# Evaluation run outputs
evals/reports/

# Local handoff notes for other AI tools (not project documentation)
HANDOFF.md
HANDOFF.pdf

# Local media storage (MEDIA_STORAGE=local)
.media/
